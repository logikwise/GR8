modules = ["nodejs-20", "bash", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
PORT = "8080"
HOST = "127.0.0.1"
SERVE_UI = "false"
PAPERCLIP_MIGRATION_AUTO_APPLY = "true"
PAPERCLIP_ALLOWED_HOSTNAMES = "e48f7db5-8102-4e3e-900d-8df58cb7c22b-00-3pcdgrnofyoch.worf.replit.dev"

[userenv.shared]
PAPERCLIP_DEPLOYMENT_MODE = "authenticated"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @paperclipai/ui dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @paperclipai/server dev"
waitForPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080
exposeLocalhost = true

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "PORT=5000 HOST=0.0.0.0 SERVE_UI=true PAPERCLIP_MIGRATION_AUTO_APPLY=true node server/dist/index.js"]
build = ["bash", "-c", "pnpm --filter @paperclipai/ui build && bash scripts/prepare-server-ui-dist.sh && pnpm --filter @paperclipai/server build"]
